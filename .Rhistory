geom_ribbon(data=Dtest, aes(x=year,ymin=yhat_test_lower, ymax=yhat_test_upper), inherit.aes=FALSE, alpha=0.2, fill="red") +
xlab("Time [monthly]") +
ylab("Number of cars registered [millions]") +
ggtitle("OLS model with forecast and prediction interval") +
scale_color_manual(
name = "",
values = c("Observed" = "black",
"Fitted" = "black",
"Forecast" = "red")
) +
